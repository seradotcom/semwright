# Preserve repository bytes for cross-platform digests and generated inputs.
*.rs text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Cargo.lock text eol=lf

# Preserve the recorded bytes of native MLT interoperability fixtures.
crates/driver-mlt-video/fixtures/kdenlive/*.kdenlive text eol=lf
crates/driver-mlt-video/fixtures/mlt/*.mlt text eol=lf
crates/driver-mlt-video/fixtures/shotcut/*.mlt text eol=lf
crates/driver-mlt-video/fixtures/shotcut/*.xml text eol=lf
