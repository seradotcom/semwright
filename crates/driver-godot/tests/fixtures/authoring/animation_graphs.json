          "position": [-80,0,0],
          "rotation": [0,0,0],
          "scale": [1,1,1],
          "groups": [],
          "node": {"kind":"visual2d","size":[48,48],"color":[0.7,0.3,0.2,1.0]}
        },
        {
          "id": "blend_visual",
          "parent": null,
          "position": [80,0,0],
          "rotation": [0,0,0],
          "scale": [1,1,1],
          "groups": [],
          "node": {"kind":"visual2d","size":[48,48],"color":[0.2,0.5,0.9,1.0]}
        },
        {
          "id": "state_animator",
          "parent": null,
          "position": [0,0,0],
          "rotation": [0,0,0],
          "scale": [1,1,1],
          "groups": [],
          "node": {"kind":"animator"}
        },
        {
          "id": "blend_animator",
          "parent": null,
          "position": [0,0,0],
          "rotation": [0,0,0],
          "scale": [1,1,1],
          "groups": [],
