{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semwright.dev/schemas/skill-lock-v1.json",
  "title": "Semwright Skill lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "requirements_sha256", "entries"],
  "properties": {
    "version": { "const": 1 },
    "requirements_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "entries": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement", "capability_id", "provider", "provider_version",
          "capability_version", "descriptor_sha256", "schema_sha256"
        ],
        "properties": {
          "requirement": { "type": "string", "maxLength": 512 },
          "capability_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
          "provider_version": { "type": "string", "maxLength": 128 },
          "capability_version": { "type": "string", "maxLength": 128 },
          "descriptor_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "schema_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        }
      }
    }
  }
}
