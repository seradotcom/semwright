{
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 16384
    },
    "inputs": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "integer",
              "boolean",
              "object",
              "array"
            ]
          },
          "default": {},
          "secret": {
            "type": "boolean"
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "integer",
              "boolean",
              "object",
              "array"
            ]
          },
          "value": {},
          "secret": {
            "type": "boolean"
          }
        },
        "required": [
          "kind",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80
          },
          "command": {
            "type": "string",
            "maxLength": 128
          },
          "args": {
            "type": "object"
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300000
          },
          "retry": {
            "type": "object",
            "properties": {
              "attempts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "backoff_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5000
              }
            },
            "required": [
              "attempts",
              "backoff_ms"
            ],
            "additionalProperties": false
          },
          "when": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "left": {},
                  "op": {
                    "enum": [
                      "equals",
                      "not_equals",
                      "truthy",
                      "exists",
                      "count_equals"
                    ]
                  },
                  "right": {}
                },
                "required": [
                  "left",
                  "op"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "left": {},
                "op": {
                  "enum": [
                    "equals",
                    "not_equals",
                    "truthy",
                    "exists",
                    "count_equals"
                  ]
                },
                "right": {}
              },
              "required": [
                "left",
                "op"
              ],
              "additionalProperties": false
            },
            "maxItems": 16
          }
        },
        "required": [
          "id",
          "command",
          "timeout_ms"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "name",
    "steps"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
