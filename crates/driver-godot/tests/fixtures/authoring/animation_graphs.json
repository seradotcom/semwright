        }
      ],
      "materials": [],
      "animations": [
        {
          "id":"idle",
          "animator":"state_animator",
          "length":1.0,
          "looping":true,
          "tracks":[{"entity":"state_visual","property":"scale","keys":[
            {"time":0.0,"value":{"kind":"vector2","value":[1.0,1.0]}},
            {"time":1.0,"value":{"kind":"vector2","value":[1.0,1.0]}}
          ]}]
        },
        {
          "id":"run",
          "animator":"state_animator",
          "length":1.0,
          "looping":true,
          "tracks":[{"entity":"state_visual","property":"scale","keys":[
            {"time":0.0,"value":{"kind":"vector2","value":[1.0,1.0]}},
            {"time":1.0,"value":{"kind":"vector2","value":[1.25,1.25]}}
          ]}]
        },
        {
          "id":"slow",
          "animator":"blend_animator",
          "length":1.0,
          "looping":true,
          "tracks":[{"entity":"blend_visual","property":"scale","keys":[
            {"time":0.0,"value":{"kind":"vector2","value":[1.0,1.0]}},
            {"time":1.0,"value":{"kind":"vector2","value":[1.05,1.05]}}
          ]}]
        },
        {
          "id":"fast",
          "animator":"blend_animator",
          "length":1.0,
          "looping":true,
          "tracks":[{"entity":"blend_visual","property":"scale","keys":[
