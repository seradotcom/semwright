            {"time":1.0,"value":{"kind":"vector2","value":[1.5,1.5]}}
          ]}]
        }
      ],
      "animation_graphs": [
        {
          "id":"motion",
          "animator":"state_animator",
          "active":true,
          "root":{
            "kind":"state_machine",
            "initial":"idle",
            "states":[
              {"id":"idle","clip":"idle","position":[-80,0]},
              {"id":"run","clip":"run","position":[80,0]}
