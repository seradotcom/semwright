{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semwright broker protocol v1 client message",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "hello"
        },
        "version": {
          "const": 1
        },
        "session": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "version",
        "session"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "execute"
        },
        "id": {
          "type": "string",
          "maxLength": 32
        },
        "request": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "maxLength": 128
            },
            "args": {
              "type": "object"
            },
            "dry_run": {
              "type": "boolean"
            },
            "backend": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 40
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "command"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "id",
        "request"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "cancel"
        },
        "id": {
          "type": "string",
          "maxLength": 32
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "subscribe"
        },
        "after": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "after"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "ping"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  ]
}
